<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Levyks.OpenDnp3.Tcp</PackageId>
    <Version>0.1.2</Version>
    <Authors>levyks</Authors>
    <Description>TCP transport for Levyks.OpenDnp3. Sockets stay in this package.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://levyks.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/levyks/opendnp3-rs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Levyks.OpenDnp3" Version="0.1.2" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
</Project>
